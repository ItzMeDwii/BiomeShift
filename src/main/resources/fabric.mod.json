{
	"schemaVersion": 1,
	"id": "biomeshift",
	"version": "${version}",
	"name": "BiomeShift",
	"description": "Change any biome into any other biome by building with ordinary vanilla blocks. Server-side only; vanilla clients can join unmodified.",
	"authors": [
		"BiomeShift contributors"
	],
	"license": "MIT",
	"environment": "server",
	"entrypoints": {
		"main": [
			"com.biomeshift.BiomeShift"
		]
	},
	"mixins": [
		"biomeshift.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"fabric-api": "*",
		"minecraft": "~26.3",
		"java": ">=25"
	}
}
